{
  "id": "renault",
  "type": "integration",
  "name": "Renault",
  "version": "0.1.0",
  "description": "Renault cars through the MyRenault cloud: battery level, range, charging state, and a remote wake to resume a paused charge",
  "icon": "Car",
  "repo": "mchacher/sowel-plugin-renault",
  "author": "mchacher",
  "sowelVersion": ">=1.73.0",
  "settings": [
    {
      "key": "email",
      "label": "E-mail MyRenault",
      "type": "text",
      "required": true
    },
    {
      "key": "password",
      "label": "Mot de passe MyRenault",
      "type": "password",
      "required": true
    },
    {
      "key": "account_label",
      "label": "Nom du compte",
      "type": "text",
      "required": false,
      "placeholder": "Compte 1"
    },
    {
      "key": "email_2",
      "label": "E-mail MyRenault 2",
      "type": "text",
      "required": false
    },
    {
      "key": "password_2",
      "label": "Mot de passe MyRenault 2",
      "type": "password",
      "required": false
    },
    {
      "key": "account_label_2",
      "label": "Nom du compte 2",
      "type": "text",
      "required": false,
      "placeholder": "Compte 2"
    },
    {
      "key": "email_3",
      "label": "E-mail MyRenault 3",
      "type": "text",
      "required": false
    },
    {
      "key": "password_3",
      "label": "Mot de passe MyRenault 3",
      "type": "password",
      "required": false
    },
    {
      "key": "account_label_3",
      "label": "Nom du compte 3",
      "type": "text",
      "required": false,
      "placeholder": "Compte 3"
    },
    {
      "key": "locale",
      "label": "Langue du compte",
      "type": "text",
      "required": false,
      "defaultValue": "fr_FR",
      "placeholder": "fr_FR"
    },
    {
      "key": "home_radius_m",
      "label": "Rayon « à la maison » (mètres)",
      "type": "number",
      "required": false,
      "defaultValue": "200",
      "placeholder": "200"
    },
    {
      "key": "gigya_api_key",
      "label": "Clé Gigya (si Renault la change)",
      "type": "text",
      "required": false
    },
    {
      "key": "kamereon_api_key",
      "label": "Clé Kamereon (si Renault la change)",
      "type": "text",
      "required": false
    }
  ],
  "apiVersion": 2
}
