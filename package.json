{
  "name": "sowel-plugin-renault",
  "version": "0.0.0",
  "description": "Sowel plugin: Renault cars through the MyRenault cloud, published as electric vehicles (core spec 183)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write --no-error-on-unmatched-pattern \"src/**/*.ts\" \"scripts/**/*.ts\" \"*.{json,md,js}\" \"docs/**/*.md\" \"specs/**/*.md\"",
    "format:check": "prettier --check --no-error-on-unmatched-pattern \"src/**/*.ts\" \"scripts/**/*.ts\" \"*.{json,md,js}\" \"docs/**/*.md\" \"specs/**/*.md\"",
    "validate": "npm run typecheck && npm run typecheck:tests && npm run lint && npm run format:check && npm test && npm run build && bash scripts/check-specs-index.sh",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,js}": [
      "prettier --write"
    ],
    "{docs,specs}/**/*.md": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "license": "AGPL-3.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
